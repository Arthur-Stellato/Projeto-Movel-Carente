# Configuração do banco de dados (Supabase na nuvem ou PostgreSQL local)
# Para usar o Supabase, defina DATABASE_URL e DIRECT_URL:
DATABASE_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Se for usar PostgreSQL local via Docker (--profile local-db):
POSTGRES_PASSWORD=uma-senha-local-forte
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# SMTP é opcional. Sem SMTP_HOST, os e-mails são exibidos no log do worker.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=MóvelCarente <nao-responda@movelcarente.local>