DATABASE_URL="postgresql://usuario:senha@localhost:5432/movelcarente_dev?schema=public"
JWT_SECRET="gere_um_segredo_aleatorio_com_no_minimo_32_caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# Origens autorizadas a chamar a API pelo navegador. Em produção, use a URL
# pública exata do frontend, sem curingas.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
CEP_PROVIDER="viacep"

# SMTP é opcional no desenvolvimento. Nunca inclua credenciais reais neste
# arquivo; mantenha-as somente no .env local ou no gerenciador de segredos.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MóvelCarente <nao-responda@movelcarente.local>"

# Não habilite fora do desenvolvimento local.
EXPOR_TOKENS_DEV="false"

# Use true somente quando frontend e API estiverem em sites distintos e ambos
# forem servidos por HTTPS. Em desenvolvimento local, mantenha false.
COOKIE_CROSS_SITE="false"
