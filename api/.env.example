DATABASE_URL="postgresql://usuario:senha@localhost:5432/movelcarente_dev?schema=public"
JWT_SECRET="troque_por_um_segredo_forte"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
# Uma ou mais origens (separadas por vírgula) autorizadas a chamar a API via
# navegador. localhost:3000 cobre o próprio Swagger UI; adicione a porta do seu
# frontend em desenvolvimento (Vite = 5173 por padrão) e, em produção, a URL
# real do frontend publicado.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
# Provedor externo consultado pra CEPs novos (ver src/services/cep.service.js).
# "viacep" (padrão) é gratuita e sem chave de API, mas não devolve latitude/
# longitude. "brasilapi" devolve coordenada quando disponível, mas exige mais
# do provedor de hospedagem/rede. Trocar aqui não muda nada mais no código.
CEP_PROVIDER="viacep"
